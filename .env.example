# Copia este archivo como .env y cambia las contraseñas. NO subas .env a GitHub.
MYSQL_DATABASE=sabitech_web
MYSQL_USER=sabitechUser
MYSQL_PASSWORD=cambia_esta_password
MYSQL_ROOT_PASSWORD=cambia_esta_password_root
# Puerto de tu PC para MySQL Workbench. Cámbialo si el 3307 da error en Windows (ej. 3310)
MYSQL_HOST_PORT=3307
