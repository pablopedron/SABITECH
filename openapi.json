{
  "openapi": "3.0.0",
  "info": {
    "title": "SABITECH WEB API",
    "description": "Contrato del frontend de SABITECH WEB (PGD Technologies S.L.): jornadas tecnológicas con inscripción, control de aforo y asistencia por QR.",
    "version": "1.1.0",
    "contact": {
      "name": "PGD Technologies S.L."
    }
  },
  "servers": [
    {
      "url": "http://localhost:8080/api",
      "description": "Desarrollo (Docker)"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Registro, inicio y cierre de sesión"
    },
    {
      "name": "Talks",
      "description": "Catálogo, inscripción y cancelación"
    },
    {
      "name": "Attendances",
      "description": "Valoración de charlas a las que se asistió"
    }
  ],
  "paths": {
    "/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Registro de usuario",
        "description": "Crea la cuenta con el rol 'asistente'. Email duplicado = 422. accessibility_needs solo se guarda con accessibility_consent=true.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              },
              "example": {
                "name": "Laura Pérez",
                "email": "laura@example.com",
                "password": "Secreta123",
                "zip_code": "46001",
                "accessibility_needs": "Acceso para silla de ruedas"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuario creado. Devuelve el token (ya queda autenticado)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          }
        }
      }
    },
    "/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Autenticación de usuario",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              },
              "example": {
                "email": "laura@example.com",
                "password": "Secreta123"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Autenticación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          }
        },
        "description": "401 con el mismo mensaje si el email no existe, la contraseña es incorrecta o el usuario está inactivo. Máximo 10 intentos por minuto."
      }
    },
    "/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Cerrar sesión",
        "description": "Revoca solo el token actual.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Sesión cerrada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Sesión cerrada."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Usuario autenticado",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Datos del usuario con sus roles",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/talks": {
      "get": {
        "tags": [
          "Talks"
        ],
        "summary": "Catálogo público de charlas publicadas",
        "description": "Público (sin token). Solo charlas publicadas, ordenadas por fecha de inicio, con categoría, ubicación y plazas libres.",
        "parameters": [
          {
            "name": "category_id",
            "in": "query",
            "required": false,
            "description": "Filtra por categoría",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Listado de charlas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Talk"
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          }
        },
        "security": []
      }
    },
    "/talks/{id}": {
      "get": {
        "tags": [
          "Talks"
        ],
        "summary": "Detalle de una charla publicada",
        "description": "Público (sin token). Un borrador o una charla inexistente responde 404.",
        "security": [],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Charla",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Talk"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/talks/inscribe": {
      "post": {
        "tags": [
          "Talks"
        ],
        "summary": "Inscribirse en una charla",
        "description": "Crea el registro en talk_user con estado 'confirmada' e incrementa seats_taken de forma atómica. El usuario se toma del token. [PENDIENTE de implementar: se cierra en una versión posterior del contrato]",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InscribeRequest"
              },
              "example": {
                "talk_id": 3
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Inscripción confirmada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Registration"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/talks/cancel": {
      "post": {
        "tags": [
          "Talks"
        ],
        "summary": "Cancelar la inscripción a una charla",
        "description": "Pasa el estado a 'cancelada', libera una plaza y guarda el motivo analítico, que es obligatorio. [PENDIENTE de implementar]",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelRequest"
              },
              "example": {
                "talk_id": 3,
                "cancellation_reason": "Incompatibilidad de horario"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Inscripción cancelada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Registration"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          }
        }
      }
    },
    "/attendances/rate": {
      "post": {
        "tags": [
          "Attendances"
        ],
        "summary": "Valorar una charla",
        "description": "Guarda rating y feedback_comment en user_talk_qr. Solo es posible si la asistencia fue validada por QR (checked_in_at no nulo). [PENDIENTE de implementar]",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RateRequest"
              },
              "example": {
                "talk_id": 3,
                "rating": 5,
                "feedback_comment": "Muy útil y bien explicada"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Valoración registrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Attendance"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Token de Laravel Sanctum",
        "description": "Token devuelto por /login o /register. Cabecera: Authorization: Bearer <token>"
      }
    },
    "schemas": {
      "RegisterRequest": {
        "type": "object",
        "required": [
          "name",
          "email",
          "password"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 150
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 190
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 8
          },
          "zip_code": {
            "type": "string",
            "pattern": "^[0-9]{5}$",
            "example": "46001",
            "nullable": true
          },
          "accessibility_needs": {
            "type": "string",
            "maxLength": 255,
            "nullable": true,
            "description": "Dato analítico: necesidades de accesibilidad"
          },
          "accessibility_consent": {
            "type": "boolean",
            "description": "Obligatorio (true) si se envía accessibility_needs. Sin consentimiento no se guarda."
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        }
      },
      "AuthToken": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string"
          },
          "token_type": {
            "type": "string",
            "example": "Bearer"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "is_active": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          },
          "zip_code": {
            "type": "string",
            "nullable": true
          },
          "accessibility_needs": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Talk": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 3
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "starts_at": {
            "type": "string",
            "format": "date-time"
          },
          "ends_at": {
            "type": "string",
            "format": "date-time"
          },
          "speaker_name": {
            "type": "string"
          },
          "speaker_company": {
            "type": "string",
            "nullable": true
          },
          "speaker_bio": {
            "type": "string",
            "nullable": true
          },
          "speaker_photo": {
            "type": "string",
            "nullable": true
          },
          "speaker_photo_alt": {
            "type": "string",
            "nullable": true,
            "description": "Texto alternativo; obligatorio si hay foto"
          },
          "category": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              }
            }
          },
          "location": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "address": {
                "type": "string"
              }
            }
          },
          "capacity": {
            "type": "integer",
            "example": 50
          },
          "seats_available": {
            "type": "integer",
            "example": 18,
            "description": "Plazas libres (aforo - ocupadas). 0 = completa"
          }
        }
      },
      "InscribeRequest": {
        "type": "object",
        "required": [
          "talk_id"
        ],
        "properties": {
          "talk_id": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "CancelRequest": {
        "type": "object",
        "required": [
          "talk_id",
          "cancellation_reason"
        ],
        "properties": {
          "talk_id": {
            "type": "integer",
            "minimum": 1
          },
          "cancellation_reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "Dato analítico: motivo de cancelación"
          }
        }
      },
      "Registration": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "user_id": {
            "type": "integer"
          },
          "talk_id": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "confirmada",
              "cancelada"
            ]
          },
          "cancellation_reason": {
            "type": "string",
            "nullable": true
          },
          "registered_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RateRequest": {
        "type": "object",
        "required": [
          "talk_id",
          "rating"
        ],
        "properties": {
          "talk_id": {
            "type": "integer",
            "minimum": 1
          },
          "rating": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "feedback_comment": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Attendance": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "user_id": {
            "type": "integer"
          },
          "talk_id": {
            "type": "integer"
          },
          "checked_in_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "rating": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "nullable": true
          },
          "feedback_comment": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "UserSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 3
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "asistente",
                "organizacion",
                "personal_acceso"
              ]
            }
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserSummary"
          },
          "token": {
            "type": "string",
            "example": "1|A91jBdVroiEZDL27Ihzz..."
          }
        }
      },
      "Me": {
        "allOf": [
          {
            "$ref": "#/components/schemas/UserSummary"
          },
          {
            "type": "object",
            "properties": {
              "zip_code": {
                "type": "string",
                "nullable": true
              },
              "accessibility_needs": {
                "type": "string",
                "nullable": true
              }
            }
          }
        ]
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "No autenticado o credenciales incorrectas",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Charla, inscripción o asistencia no encontrada",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Conflict": {
        "description": "Conflicto: email duplicado, ya inscrito, aforo completo o valoración sin asistencia validada",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unprocessable": {
        "description": "Datos no válidos",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
