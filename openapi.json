{
  "openapi": "3.0.0",
  "info": {
    "title": "SABITECH WEB API",
    "description": "Contrato del frontend de SABITECH WEB (PGD Technologies S.L.): jornadas tecnológicas con inscripción, control de aforo y asistencia por QR.",
    "version": "1.3.0",
    "contact": {
      "name": "PGD Technologies S.L."
    }
  },
  "servers": [
    {
      "url": "http://localhost:8080/api",
      "description": "Desarrollo (Docker)"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Registro, inicio y cierre de sesión"
    },
    {
      "name": "Talks",
      "description": "Catálogo público de charlas"
    },
    {
      "name": "Reservas",
      "description": "Reservar, consultar y cancelar plazas"
    },
    {
      "name": "Attendances",
      "description": "Asistencia con QR temporal (prototipo del checkpoint)"
    },
    {
      "name": "Organizacion",
      "description": "Rutas solo para el perfil organizacion"
    }
  ],
  "paths": {
    "/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Registro de usuario",
        "description": "Crea la cuenta con el rol 'asistente'. Email duplicado = 422. accessibility_needs solo se guarda con accessibility_consent=true.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              },
              "example": {
                "name": "Laura Pérez",
                "email": "laura@example.com",
                "password": "Secreta123",
                "zip_code": "46001",
                "accessibility_needs": "Acceso para silla de ruedas"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuario creado. Devuelve el token (ya queda autenticado)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          }
        }
      }
    },
    "/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Autenticación de usuario",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              },
              "example": {
                "email": "laura@example.com",
                "password": "Secreta123"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Autenticación correcta",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          }
        },
        "description": "401 con el mismo mensaje si el email no existe, la contraseña es incorrecta o el usuario está inactivo. Máximo 10 intentos por minuto."
      }
    },
    "/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Cerrar sesión",
        "description": "Revoca solo el token actual.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Sesión cerrada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Sesión cerrada."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Usuario autenticado",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Datos del usuario con sus roles",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/talks": {
      "get": {
        "tags": [
          "Talks"
        ],
        "summary": "Catálogo público de charlas publicadas",
        "description": "Público (sin token). Solo charlas publicadas, ordenadas por fecha de inicio, con categoría, ubicación y plazas libres.",
        "parameters": [
          {
            "name": "category_id",
            "in": "query",
            "required": false,
            "description": "Filtra por categoría",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Listado de charlas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Talk"
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          }
        },
        "security": []
      }
    },
    "/talks/{id}": {
      "get": {
        "tags": [
          "Talks"
        ],
        "summary": "Detalle de una charla publicada",
        "description": "Público (sin token). Un borrador o una charla inexistente responde 404.",
        "security": [],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Charla",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Talk"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/talks/{id}/inscribe": {
      "post": {
        "tags": [
          "Reservas"
        ],
        "summary": "Reservar una plaza",
        "description": "Requiere token. Se ejecuta en una transacción con la charla bloqueada, de modo que la última plaza no puede concederse dos veces. 404: charla inexistente o borrador. 409: ya tienes reserva, no quedan plazas o la charla ya ha empezado. Si la reserva había sido cancelada, se reactiva con una referencia nueva de QR. Tras guardar la reserva se envía el correo de confirmación (en Docker llega a Mailpit, http://localhost:8025) y se registra en email_logs. Si el correo falla, la reserva se mantiene y el envío queda como fallido.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Reserva confirmada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Reservation"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/me/reservations": {
      "get": {
        "tags": [
          "Reservas"
        ],
        "summary": "Mis reservas",
        "description": "Reservas del usuario autenticado (confirmadas y canceladas), ordenadas por fecha de la charla.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Listado de reservas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Reservation"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/reservations/{id}/cancel": {
      "post": {
        "tags": [
          "Reservas"
        ],
        "summary": "Cancelar una reserva",
        "description": "Solo el dueño de la reserva (la de otra persona responde 404). Libera la plaza. 409 si ya estaba cancelada o la charla ya ha empezado.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelReservationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reserva cancelada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Reservation"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          }
        }
      }
    },
    "/reservations/{id}/qr": {
      "get": {
        "tags": [
          "Attendances"
        ],
        "summary": "Código QR actual de una reserva",
        "description": "Solo el dueño de la reserva (la de otra persona responde 404). El token cambia cada 30 s y lo calcula el servidor: HMAC-SHA256(idReserva.ventana, qr_secret), con ventana = segundos desde 1970 / 30. El frontend lo pinta como QR y lo vuelve a pedir cuando pasan seconds_left segundos. 409 si la reserva está cancelada.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Token vigente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string",
                      "description": "idReserva.ventana.firma"
                    },
                    "window": {
                      "type": "integer"
                    },
                    "valid_until": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "seconds_left": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 30
                    }
                  }
                },
                "example": {
                  "token": "12.60000000.3f9c…(64 caracteres hex)",
                  "window": 60000000,
                  "valid_until": "2027-01-15T08:00:30+00:00",
                  "seconds_left": 20
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/attendances/scan": {
      "post": {
        "tags": [
          "Attendances"
        ],
        "summary": "Registrar asistencia escaneando el QR",
        "description": "Solo personal_acceso. El servidor comprueba la firma y la caducidad con SU reloj: se acepta la ventana actual y, durante los 5 primeros segundos de una ventana, también la anterior (un código vale como máximo 35 s). 422 si el código está caducado, manipulado o la reserva no está confirmada; 409 si la asistencia ya estaba registrada (no se duplica).",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "token"
                ],
                "properties": {
                  "token": {
                    "type": "string",
                    "maxLength": 200
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Asistencia registrada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "attendee": {
                      "type": "string"
                    },
                    "talk": {
                      "type": "string"
                    },
                    "reference": {
                      "type": "string"
                    },
                    "checked_in_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                },
                "example": {
                  "message": "Asistencia registrada.",
                  "attendee": "Ana Asistente",
                  "talk": "Taller de seguridad web",
                  "reference": "SBT-7K2Q9M",
                  "checked_in_at": "2026-11-20T10:02:11+01:00"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "description": "Código caducado o no válido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "message": "Código QR caducado. Pide a la persona que muestre el código actual."
                }
              }
            }
          }
        }
      }
    },
    "/talks/{id}/reservations": {
      "get": {
        "tags": [
          "Organizacion"
        ],
        "summary": "Inscripciones de una charla",
        "description": "Solo organizacion (middleware role:organizacion). Incluye borradores. attended indica si la persona tiene asistencia registrada.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Charla e inscripciones",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "talk": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer"
                        },
                        "title": {
                          "type": "string"
                        },
                        "capacity": {
                          "type": "integer"
                        },
                        "seats_taken": {
                          "type": "integer"
                        }
                      }
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer"
                          },
                          "reference": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string",
                            "enum": [
                              "confirmada",
                              "cancelada"
                            ]
                          },
                          "registered_at": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "user": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "integer"
                              },
                              "name": {
                                "type": "string"
                              },
                              "email": {
                                "type": "string"
                              }
                            }
                          },
                          "attended": {
                            "type": "boolean"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Token de Laravel Sanctum",
        "description": "Token devuelto por /login o /register. Cabecera: Authorization: Bearer <token>"
      }
    },
    "schemas": {
      "RegisterRequest": {
        "type": "object",
        "required": [
          "name",
          "email",
          "password"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 150
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 190
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 8
          },
          "zip_code": {
            "type": "string",
            "pattern": "^[0-9]{5}$",
            "example": "46001",
            "nullable": true
          },
          "accessibility_needs": {
            "type": "string",
            "maxLength": 255,
            "nullable": true,
            "description": "Dato analítico: necesidades de accesibilidad"
          },
          "accessibility_consent": {
            "type": "boolean",
            "description": "Obligatorio (true) si se envía accessibility_needs. Sin consentimiento no se guarda."
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        }
      },
      "AuthToken": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string"
          },
          "token_type": {
            "type": "string",
            "example": "Bearer"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "is_active": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          },
          "zip_code": {
            "type": "string",
            "nullable": true
          },
          "accessibility_needs": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Talk": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 3
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "starts_at": {
            "type": "string",
            "format": "date-time"
          },
          "ends_at": {
            "type": "string",
            "format": "date-time"
          },
          "speaker_name": {
            "type": "string"
          },
          "speaker_company": {
            "type": "string",
            "nullable": true
          },
          "speaker_bio": {
            "type": "string",
            "nullable": true
          },
          "speaker_photo": {
            "type": "string",
            "nullable": true
          },
          "speaker_photo_alt": {
            "type": "string",
            "nullable": true,
            "description": "Texto alternativo; obligatorio si hay foto"
          },
          "category": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              }
            }
          },
          "location": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "address": {
                "type": "string"
              }
            }
          },
          "capacity": {
            "type": "integer",
            "example": 50
          },
          "seats_available": {
            "type": "integer",
            "example": 18,
            "description": "Plazas libres (aforo - ocupadas). 0 = completa"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "UserSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 3
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "asistente",
                "organizacion",
                "personal_acceso"
              ]
            }
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserSummary"
          },
          "token": {
            "type": "string",
            "example": "1|A91jBdVroiEZDL27Ihzz..."
          }
        }
      },
      "Me": {
        "allOf": [
          {
            "$ref": "#/components/schemas/UserSummary"
          },
          {
            "type": "object",
            "properties": {
              "zip_code": {
                "type": "string",
                "nullable": true
              },
              "accessibility_needs": {
                "type": "string",
                "nullable": true
              }
            }
          }
        ]
      },
      "Reservation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 12
          },
          "reference": {
            "type": "string",
            "example": "SBT-7K2Q9X",
            "description": "Referencia legible de la reserva (aparecerá en el correo)"
          },
          "status": {
            "type": "string",
            "enum": [
              "confirmada",
              "cancelada"
            ]
          },
          "registered_at": {
            "type": "string",
            "format": "date-time"
          },
          "cancelled_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "cancellation_reason": {
            "type": "string",
            "nullable": true
          },
          "talk": {
            "$ref": "#/components/schemas/Talk"
          }
        }
      },
      "CancelReservationRequest": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 255,
            "nullable": true,
            "description": "Motivo de la cancelación (opcional)"
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "No autenticado o credenciales incorrectas",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Charla, inscripción o asistencia no encontrada",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Conflict": {
        "description": "Conflicto: email duplicado, ya inscrito, aforo completo o valoración sin asistencia validada",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unprocessable": {
        "description": "Datos no válidos",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Autenticado, pero sin el rol necesario",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "message": "No tienes permiso para esta acción."
            }
          }
        }
      }
    }
  }
}
